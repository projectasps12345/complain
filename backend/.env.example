# ==============================================================================
# CivicPulse AI Backend Environment Configuration
# ==============================================================================

PORT=5000
JWT_SECRET=civicpulse_ai_secure_jwt_secret_token_2026_xyz
ML_SERVICE_URL=http://localhost:8000

# ==============================================================================
# MongoDB Atlas Cloud Database URI
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/civicpulse?retryWrites=true&w=majority
# Replace <username> and <password> with your Atlas cluster credentials.
# Leave blank to run in local embedded JSON mode.
# ==============================================================================
MONGODB_URI=

# ==============================================================================
# Cloudinary Evidence Storage Configuration
# ------------------------------------------------------------------------------
# Create a free Cloudinary account at https://cloudinary.com
# Find your cloud credentials in your Cloudinary Dashboard:
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
